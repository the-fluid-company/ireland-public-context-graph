---
const manifest = await import('../../public/data/manifest.json').then(m => m.default).catch(() => ({ generatedAt:'pending', datasetCount:0, entityCount:0, relationshipCount:0, brainIssueCount:0, brainFactorCount:0, brainEvidenceEdgeCount:0 }));
const brain = await import('../../public/data/brain-index.json').then(m => m.default).catch(() => ({ issues:[], issueCount:0, factorCount:0, evidenceEdgeCount:0 }));
const examples = [
  'Why is flooding happening in Tallaght?',
  'Is this road dangerous near a school?',
  'What services are missing in my area?',
  'What changed around this neighbourhood?'
];
const updatedLabel = (() => {
  const d = new Date(manifest.generatedAt);
  if (Number.isNaN(d.getTime())) return 'update pending';
  return new Intl.DateTimeFormat('en-IE', { day:'numeric', month:'long', year:'numeric', hour:'2-digit', minute:'2-digit', timeZone:'UTC', timeZoneName:'short' }).format(d);
})();
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Ask Ireland's Public Data</title>
  <meta name="description" content="Ask simple questions about places in Ireland and see public evidence, possible reasons and missing information in plain English." />
  <style>
    :root{
      --ink:#132018;--muted:#607066;--paper:#fcfbf2;--card:#fffef8;--green:#123d2b;--soft:#e9f4db;--mint:#cfe8c0;--blue:#dceef8;--gold:#f4c96b;--red:#d87551;--line:#dfe6d7;--shadow:0 24px 80px rgba(20,50,32,.13);
      font-family:ui-serif, Georgia, Cambria, "Times New Roman", serif;color:var(--ink);background:var(--paper);line-height:1.5;
    }
    *{box-sizing:border-box} body{margin:0;background:radial-gradient(circle at 10% -10%,#dff1c7 0,transparent 34rem),radial-gradient(circle at 90% 0,#e2f3ff 0,transparent 34rem),var(--paper)}
    button,input{font:inherit} a{color:var(--green)} .wrap{max-width:1180px;margin:auto;padding:22px 18px 46px}
    .hero{display:grid;grid-template-columns:1.05fr .95fr;gap:26px;align-items:center;min-height:620px}.eyebrow{display:inline-flex;align-items:center;gap:8px;border:1px solid var(--line);background:#fff;border-radius:999px;padding:8px 12px;font:800 12px/1.1 ui-sans-serif,system-ui,sans-serif;letter-spacing:.08em;text-transform:uppercase;color:#31523d}.hero h1{font-size:clamp(46px,7vw,92px);line-height:.91;letter-spacing:-.06em;margin:20px 0 16px}.lead{font-size:clamp(19px,2.1vw,26px);max-width:760px;color:#2c3f33}.plain-note{display:flex;gap:12px;align-items:flex-start;background:#fff8e7;border:1px solid #f1d99a;border-radius:22px;padding:15px 17px;max-width:760px;color:#463614}.plain-note b{white-space:nowrap}.ask-box{background:var(--card);border:1px solid var(--line);border-radius:30px;padding:18px;box-shadow:var(--shadow);margin-top:22px}.ask-row{display:flex;gap:10px}.ask-row input{width:100%;border:1px solid var(--line);border-radius:18px;background:white;padding:16px 17px;font-size:18px;outline:0}.ask-row input:focus{border-color:var(--green);box-shadow:0 0 0 4px #dcebd3}.btn{border:0;border-radius:18px;background:var(--green);color:white;padding:14px 20px;font:900 15px ui-sans-serif,system-ui,sans-serif;cursor:pointer}.chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}.chip{border:1px solid var(--line);background:#f8fbf1;border-radius:999px;padding:9px 12px;color:#314238;cursor:pointer}.chip:hover{background:var(--soft)}
    .map-card{position:relative;min-height:500px;border-radius:38px;overflow:hidden;background:linear-gradient(145deg,#f7f2d9,#d8ecd1 45%,#cde7f5);border:1px solid rgba(35,65,45,.12);box-shadow:var(--shadow)}.map-card:before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(20,60,40,.08) 1px,transparent 1px),linear-gradient(90deg,rgba(20,60,40,.08) 1px,transparent 1px);background-size:42px 42px}.ireland{position:absolute;right:30px;top:28px;width:270px;opacity:.95}.pin{position:absolute;left:48%;top:40%;width:18px;height:18px;background:var(--red);border-radius:50% 50% 50% 0;transform:rotate(-45deg);box-shadow:0 0 0 8px rgba(216,117,81,.18)}.story{position:absolute;left:24px;right:24px;bottom:24px;background:rgba(255,255,248,.9);backdrop-filter:blur(8px);border:1px solid rgba(255,255,255,.7);border-radius:28px;padding:20px}.story h2{font-size:30px;line-height:1;margin:0 0 10px}.mini-links{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-top:14px}.mini{background:white;border:1px solid var(--line);border-radius:18px;padding:12px;font:800 13px ui-sans-serif,system-ui,sans-serif}.mini span{display:block;font:500 12px ui-sans-serif,system-ui,sans-serif;color:var(--muted);margin-top:2px}
    .section{margin-top:34px}.section-head{display:flex;justify-content:space-between;align-items:end;gap:18px;margin-bottom:14px}.section h2{font-size:clamp(32px,4vw,54px);line-height:.95;letter-spacing:-.04em;margin:0}.muted{color:var(--muted)}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.card{background:var(--card);border:1px solid var(--line);border-radius:28px;padding:20px;box-shadow:0 10px 40px rgba(20,50,32,.06)}.card h3{margin:0 0 8px;font-size:24px}.card p{margin:0}.number{font:900 38px ui-sans-serif,system-ui,sans-serif;color:var(--green);letter-spacing:-.04em}.answer-grid{display:grid;grid-template-columns:.78fr 1.22fr;gap:16px}.tabs{display:grid;gap:9px}.tab{border:1px solid var(--line);background:white;border-radius:20px;padding:14px;text-align:left;cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:12px}.tab.active{background:var(--green);color:white;border-color:var(--green)}.tab strong{display:block;font:900 16px ui-sans-serif,system-ui,sans-serif}.tab span{display:inline-flex;white-space:nowrap;border-radius:999px;background:#eef6e8;padding:6px 9px;font:800 12px ui-sans-serif,system-ui,sans-serif;color:#31523d}.tab.active span{background:rgba(255,255,255,.18);color:white}.answer{min-height:420px}.answer-title{font-size:38px;line-height:1;letter-spacing:-.035em;margin:0 0 10px}.simple-summary{background:var(--soft);border:1px solid #cfe2bf;border-radius:24px;padding:17px;margin:12px 0 18px;font-size:18px}.reason-list{display:grid;gap:12px}.reason{border:1px solid var(--line);background:#fff;border-radius:22px;padding:16px}.reason-head{display:flex;justify-content:space-between;gap:10px;align-items:center}.reason h4{margin:0;font-size:21px}.badge{font:900 12px ui-sans-serif,system-ui,sans-serif;border-radius:999px;padding:6px 9px;background:#edf6e8;color:#24513a}.badge.medium{background:#fff3d8;color:#6a4b05}.badge.weak{background:#f8e7dd;color:#7b321a}.why{margin:8px 0;color:#415147}.sources{margin-top:10px}.sources summary{cursor:pointer;font:900 13px ui-sans-serif,system-ui,sans-serif;color:var(--green)}.source-link{display:block;margin-top:8px;border-left:4px solid var(--mint);padding:8px 10px;background:#f9fbf3;text-decoration:none;border-radius:0 12px 12px 0}.small{font:500 13px ui-sans-serif,system-ui,sans-serif}.missing{margin-top:18px;padding:16px;border-radius:22px;background:#fff9e9;border:1px solid #ead79f}.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.step{background:#173d2b;color:white;border-radius:24px;padding:18px;min-height:140px}.step b{display:block;font:900 42px/1 ui-sans-serif,system-ui,sans-serif;color:var(--gold);margin-bottom:14px}.dev{margin-top:30px;border-top:1px solid var(--line);padding-top:18px}.dev summary{cursor:pointer;font:900 14px ui-sans-serif,system-ui,sans-serif;color:#31523d}.dev-links{display:flex;flex-wrap:wrap;gap:10px;margin-top:12px}.dev-links a{background:white;border:1px solid var(--line);border-radius:999px;padding:9px 12px;text-decoration:none;font:800 13px ui-sans-serif,system-ui,sans-serif}footer{margin-top:34px;color:var(--muted);font:500 13px ui-sans-serif,system-ui,sans-serif}
    @media(max-width:900px){.hero,.answer-grid{grid-template-columns:1fr}.hero{min-height:auto}.cards,.steps{grid-template-columns:1fr 1fr}.map-card{min-height:430px}.ask-row{flex-direction:column}.btn{width:100%}}
    @media(max-width:560px){.wrap{padding:16px 12px 34px}.hero h1{font-size:47px}.cards,.steps,.mini-links{grid-template-columns:1fr}.section-head{display:block}.map-card{min-height:390px}.ireland{width:220px;right:12px}.story{left:14px;right:14px;bottom:14px}.answer-title{font-size:32px}}
  </style>
</head>
<body>
  <main class="wrap">
    <section class="hero">
      <div>
        <span class="eyebrow">Public beta · Ireland</span>
        <h1>Ask Ireland’s public data a question.</h1>
        <p class="lead">Type a place or problem. See the possible reasons, the trusted public sources, and what information is still missing — in plain English.</p>
        <div class="plain-note"><b>Not official advice.</b><span>This site helps people understand public evidence. It does not decide blame, legal responsibility, engineering safety, or policy.</span></div>
        <div id="ask" class="ask-box">
          <div class="ask-row">
            <input id="q" value="Why is flooding happening in Tallaght?" placeholder="Example: Why is flooding happening in Tallaght?" aria-label="Ask a public data question" />
            <button class="btn" id="askBtn">See context</button>
          </div>
          <div class="chips">{examples.map(x => <button class="chip" data-question={x}>{x}</button>)}</div>
        </div>
      </div>
      <div class="map-card" aria-label="Simple map style illustration of connected public information">
        <svg class="ireland" viewBox="0 0 280 360" aria-hidden="true"><path d="M151 8c32 14 29 45 50 62 20 16 51 14 60 42 8 26-15 42-11 67 5 33 36 54 22 84-12 28-48 22-69 42-22 20-25 52-60 52-31 0-38-32-61-43-25-12-61 0-76-28-15-29 14-52 20-81 6-30-15-60 1-86 17-28 54-22 77-42 24-20 18-84 47-69Z" fill="#fefcf2" stroke="#123d2b" stroke-width="3"/><path d="M62 107c48 18 99 25 158 16M43 190c62-12 131-2 194 34M114 68c-8 62 16 126 70 196" fill="none" stroke="#90b583" stroke-width="7" opacity=".55"/><circle cx="143" cy="163" r="10" fill="#d87551"/></svg>
        <span class="pin" aria-hidden="true"></span>
        <div class="story">
          <h2>From question to context</h2>
          <p class="muted">The brain connects places, weather, roads, rivers, services, planning and other public records so ordinary people can see what may be related.</p>
          <div class="mini-links"><div class="mini">Possible reasons<span>Plain English first</span></div><div class="mini">Map context<span>What's nearby</span></div><div class="mini">Trusted sources<span>Open public data</span></div><div class="mini">Missing info<span>What's still unknown</span></div></div>
        </div>
      </div>
    </section>

    <section class="section answer-grid">
      <div class="card">
        <h2 style="font-size:34px">Pick a question type</h2>
        <p class="muted">We group your question into the closest topic.</p>
        <div id="issues" class="tabs" style="margin-top:14px"></div>
      </div>
      <div id="answer" class="card answer"></div>
    </section>

    <section class="section">
      <div class="section-head"><div><h2>How to read an answer</h2><p class="muted">Designed for normal people first. Technical detail stays underneath.</p></div></div>
      <div class="steps">
        <div class="step"><b>1</b>Ask a question about a place.</div>
        <div class="step"><b>2</b>See possible reasons, not a forced conclusion.</div>
        <div class="step"><b>3</b>Open the sources behind each reason.</div>
        <div class="step"><b>4</b>Check what evidence is missing or weak.</div>
      </div>
    </section>

    <section class="section">
      <div class="section-head"><div><h2>What is inside today</h2><p class="muted">The public version hides jargon, but still checks open evidence behind the scenes.</p></div></div>
      <div class="cards">
        <div class="card"><div class="number">{manifest.datasetCount?.toLocaleString?.() ?? manifest.datasetCount}</div><h3>public datasets</h3><p class="muted">Sources from Irish public data catalogues and agencies.</p></div>
        <div class="card"><div class="number">{manifest.brainFactorCount ?? brain.factorCount}</div><h3>topics covered</h3><p class="muted">Flooding, road safety, services and planning context to start.</p></div>
        <div class="card"><div class="number">{manifest.brainEvidenceEdgeCount ?? brain.evidenceEdgeCount}</div><h3>public sources</h3><p class="muted">Connections between possible reasons and supporting public records.</p></div>
      </div>
    </section>

    <details class="dev">
      <summary>Developer and agent access</summary>
      <div class="dev-links">
        <a href="https://ireland-public-context-graph-mcp.amreshtech.workers.dev/api/ask?q=Why%20is%20flooding%20happening%20in%20Tallaght">Ask API</a>
        <a href="https://ireland-public-context-graph-mcp.amreshtech.workers.dev/api/brain">Brain API</a>
        <a href="https://ireland-public-context-graph-mcp.amreshtech.workers.dev/artifacts/brain-index.json">Brain artifact</a>
        <a href="/mcp">MCP instructions</a>
        <a href="https://github.com/the-fluid-company/ireland-public-context-graph">GitHub</a>
      </div>
    </details>

    <footer>Updated {updatedLabel}. Public evidence context only; no official conclusions.</footer>
  </main>

  <script is:inline>
    // @ts-nocheck
    const state = { brain:null, selected:null };
    const q = document.getElementById('q');
    const answer = document.getElementById('answer');
    const issuesEl = document.getElementById('issues');
    const esc = s => String(s ?? '').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    const norm = s => String(s ?? '').toLowerCase();
    function scoreIssue(issue, query){
      const text = norm(`${issue.id} ${issue.label} ${(issue.examples||[]).join(' ')} ${(issue.factors||[]).map(f=>`${f.label} ${f.description} ${(f.keywords||[]).join(' ')}`).join(' ')}`);
      return norm(query).split(/[^a-z0-9-]+/).filter(Boolean).reduce((n,t)=>n+(text.includes(t)?(t.length>3?3:1):0), text.includes(norm(query))?10:0);
    }
    function plainIssueLabel(label){
      return String(label || '').replace(/ context$/i,'').replace('Public service access','Local services');
    }
    function simpleFactorLabel(label){
      const map = {
        'Rainfall intensity and duration':'Heavy rain',
        'River level and upstream/downstream cascade':'Rivers and streams rising',
        'Soil saturation and infiltration capacity':'Ground already soaked',
        'Elevation, slope and flow paths':'Low ground and slopes',
        'Impervious surface and land cover':'Concrete, roads and hard surfaces',
        'Drainage, culverts and road barriers':'Drains, culverts and road layout'
      };
      return map[label] || label;
    }
    function strengthText(s){
      if(s === 'strong') return 'good public evidence';
      if(s === 'medium') return 'some public evidence';
      if(s === 'weak') return 'limited public evidence';
      return 'evidence unclear';
    }
    function makeSummary(issue, factors){
      const names = factors.slice(0,4).map(f => String(simpleFactorLabel(f.label) || '').toLowerCase());
      if(!names.length) return 'The brain has not found enough public context for this question yet.';
      return `This question may be related to ${names.join(', ')}. Treat these as possible reasons to investigate, not as an official conclusion.`;
    }
    function rankedIssues(){
      const brain = state.brain || {issues:[]};
      return [...(brain.issues||[])].map(issue=>({issue,score:scoreIssue(issue,q.value)})).sort((a,b)=>b.score-a.score);
    }
    function chooseIssue(){
      const brain = state.brain || {issues:[]};
      if(state.selected) return (brain.issues||[]).find(i => i.id === state.selected) || brain.issues?.[0];
      const ranked = rankedIssues();
      return ranked[0]?.score > 0 ? ranked[0].issue : (brain.issues||[])[0];
    }
    function render(){
      const brain = state.brain || {issues:[]};
      const current = chooseIssue();
      issuesEl.innerHTML = (brain.issues||[]).map(issue => `<button class="tab ${issue.id===current?.id?'active':''}" data-id="${esc(issue.id)}"><strong>${esc(plainIssueLabel(issue.label))} · ${(issue.factors||[]).length} reasons</strong></button>`).join('');
      issuesEl.querySelectorAll('button').forEach(b => b.onclick = () => { state.selected = b.dataset.id; render(); });
      renderIssue(current);
    }
    function renderIssue(issue){
      if(!issue){ answer.innerHTML = '<h2 class="answer-title">No public brain loaded yet.</h2><p class="muted">Try again shortly.</p>'; return; }
      const factors = (issue.factors||[]);
      const evidenceTotal = factors.reduce((n,f)=>n+(f.evidenceCount||0),0);
      answer.innerHTML = `
        <p class="eyebrow">Answer preview</p>
        <h2 class="answer-title">${esc(plainIssueLabel(issue.label))}</h2>
        <div class="simple-summary">${esc(makeSummary(issue, factors))}</div>
        <p class="muted small">Showing the top 3 possible reasons first. Based on ${factors.length} possible reasons and ${evidenceTotal} public sources.</p>
        <div class="reason-list">
          ${factors.slice(0,3).map(f => `
            <article class="reason">
              <div class="reason-head"><h4>${esc(simpleFactorLabel(f.label))}</h4><span class="badge ${esc(f.strongestEvidence)}">${esc(strengthText(f.strongestEvidence))}</span></div>
              <p class="why">${esc(f.description || 'This may be relevant to the question.')}</p>
              <details class="sources">
                <summary>Show public sources</summary>
                ${(f.evidenceDatasets||[]).slice(0,3).map(e => `<a class="source-link" href="${esc(e.sourceUrl)}" target="_blank" rel="noreferrer"><strong>${esc(e.title)}</strong><br><span class="muted small">${esc(e.publisher)} · ${esc(e.evidenceStrength || 'evidence')}</span></a>`).join('') || `<p class="muted small">No strong public source linked yet. ${esc(f.missingIfAbsent || '')}</p>`}
              </details>
            </article>
          `).join('')}
        </div>
        <div class="missing"><strong>What may still be missing:</strong><ul>${(issue.missingEvidence||[]).slice(0,4).map(x => `<li>${esc(x)}</li>`).join('') || '<li>No major type of information is marked as missing yet, but this is still a public beta.</li>'}</ul></div>
      `;
    }
    document.getElementById('askBtn').onclick = () => { state.selected = null; render(); };
    q.addEventListener('keydown', e => { if(e.key === 'Enter'){ state.selected = null; render(); }});
    document.querySelectorAll('[data-question]').forEach(b => b.onclick = () => { q.value = b.dataset.question; state.selected = null; render(); });
    fetch('/data/brain-index.json').then(r=>r.json()).then(data=>{state.brain=data;render();}).catch(()=>{answer.innerHTML='<h2 class="answer-title">Brain data failed to load.</h2>';});
  </script>
</body>
</html>
