---
const manifest = await import('../../public/data/manifest.json').then(m => m.default).catch(() => ({ generatedAt:'pending', datasetCount:0, entityCount:0, relationshipCount:0, brainIssueCount:0, brainFactorCount:0, brainEvidenceEdgeCount:0 }));
const brain = await import('../../public/data/brain-index.json').then(m => m.default).catch(() => ({ issues:[], learningLoop:[], architecture:{}, issueCount:0, factorCount:0, evidenceEdgeCount:0 }));
const graph = await import('../../public/data/graph-index.json').then(m => m.default).catch(() => ({ domains:{} }));
const topDomains = Object.entries(graph.domains ?? {}).sort((a,b)=>Number(b[1])-Number(a[1])).slice(0,10);
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Ireland Public Context Brain</title>
  <meta name="description" content="A living public-context brain for Ireland: ask civic questions and retrieve connected factors, evidence, confidence and missing data." />
  <style>
    :root{--ink:#101914;--muted:#647069;--paper:#fbfaf1;--card:#fffdf3;--green:#173c2b;--moss:#315f42;--lime:#d7ee7f;--blue:#b9d8ef;--orange:#d6804b;--line:#dfe4d4;--shadow:0 28px 80px rgba(19,43,29,.15);font-family:"Aptos","Segoe UI",system-ui,sans-serif;line-height:1.45;color:var(--ink);background:var(--paper)}
    *{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 8% 0,#e8f5c4 0,transparent 30rem),radial-gradient(circle at 92% 10%,#dbeeff 0,transparent 28rem),var(--paper)}a{color:var(--green)}.wrap{max-width:1260px;margin:auto;padding:28px 18px 50px}.hero{display:grid;grid-template-columns:1.05fr .95fr;gap:22px;align-items:stretch;padding:32px 0}.eyebrow{display:inline-flex;border-radius:999px;background:#101914;color:#f5ffe0;padding:7px 12px;font-size:12px;font-weight:900;letter-spacing:.08em;text-transform:uppercase}.hero h1{font-family:Georgia,"Times New Roman",serif;font-size:clamp(46px,7vw,92px);letter-spacing:-.07em;line-height:.9;margin:18px 0}.lead{font-size:clamp(18px,2vw,24px);color:#314238;max-width:820px}.boundary{border-left:5px solid var(--orange);background:#fff4e5;padding:12px 14px;border-radius:0 16px 16px 0}.button{display:inline-flex;align-items:center;gap:8px;border:0;border-radius:14px;background:var(--green);color:white;text-decoration:none;font-weight:900;padding:12px 16px;cursor:pointer}.button.secondary{background:white;color:var(--green);border:1px solid var(--line)}.actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:18px}.brain-card{position:relative;overflow:hidden;min-height:520px;border-radius:34px;background:linear-gradient(145deg,#102018,#315f42 55%,#6c9159);color:white;box-shadow:0 34px 90px rgba(20,52,35,.28);padding:22px}.brain-card:before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.08) 1px, transparent 1px),linear-gradient(90deg,rgba(255,255,255,.08) 1px,transparent 1px);background-size:34px 34px;mask-image:linear-gradient(to bottom,#000,transparent 92%)}.brain-card>*{position:relative;z-index:1}.brain-map{position:absolute;right:20px;top:20px;width:230px;height:170px;border-radius:24px;background:rgba(255,255,255,.10);border:1px solid rgba(255,255,255,.25);overflow:hidden}.hero-nodes{position:absolute;inset:150px 22px 95px}.hnode{position:absolute;padding:10px 13px;border-radius:999px;background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.28);backdrop-filter:blur(6px);font-size:13px;font-weight:900}.hnode.q{left:35%;top:38%;background:#f8ffe7;color:#173c2b}.hnode.a{left:2%;top:8%}.hnode.b{right:4%;top:2%;background:rgba(215,238,127,.25)}.hnode.c{right:2%;bottom:12%;background:rgba(185,216,239,.25)}.hnode.d{left:5%;bottom:5%;background:rgba(214,128,75,.30)}.hedge{position:absolute;height:2px;background:rgba(255,255,255,.5);transform-origin:left}.e1{left:21%;top:34%;width:26%;transform:rotate(18deg)}.e2{left:54%;top:42%;width:29%;transform:rotate(-25deg)}.e3{left:56%;top:56%;width:27%;transform:rotate(24deg)}.e4{left:24%;top:73%;width:24%;transform:rotate(-26deg)}.stats{position:absolute;left:20px;right:20px;bottom:20px;display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.stat{background:rgba(255,255,255,.13);border:1px solid rgba(255,255,255,.2);border-radius:18px;padding:12px}.stat b{display:block;font-size:24px}.stat span{font-size:12px;color:#edf8df}.section-title{display:flex;justify-content:space-between;align-items:end;gap:16px;margin:26px 0 12px}.section-title h2{font-family:Georgia,"Times New Roman",serif;font-size:clamp(30px,4vw,52px);letter-spacing:-.05em;margin:0}.muted{color:var(--muted)}.small{font-size:13px}.mono{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px;word-break:break-all}.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.card{background:rgba(255,253,243,.88);border:1px solid var(--line);border-radius:24px;padding:20px;box-shadow:var(--shadow)}.card.flat{box-shadow:none}.ask{display:grid;grid-template-columns:1fr auto;gap:10px}.ask input{width:100%;border:1px solid #cbd6c5;border-radius:16px;background:#fffef8;padding:15px;font-size:16px}.chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}.chip,.pill{display:inline-flex;border:1px solid #d7ddcc;background:#f5f8ea;border-radius:999px;padding:6px 10px;font-size:12px;color:#2f4135}.chip{cursor:pointer}.chip:hover{background:#e8f5c4}.two{display:grid;grid-template-columns:.9fr 1.1fr;gap:16px}.issue-list{display:grid;gap:10px}.issue-btn{width:100%;text-align:left;border:1px solid var(--line);background:#fffef8;border-radius:18px;padding:14px;cursor:pointer}.issue-btn.active,.issue-btn:hover{background:#f3f9df;border-color:#cddfb1}.issue-btn strong{display:block}.factor-list{display:grid;gap:12px}.factor{border:1px solid var(--line);border-radius:20px;background:#fffef8;padding:14px}.factor-head{display:flex;justify-content:space-between;gap:10px}.strength{font-weight:900}.strength.strong{color:#0b6b37}.strength.medium{color:#a86512}.strength.weak,.strength.missing{color:#9a3424}.evidence{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin-top:10px}.ev{border:1px solid #e2e7da;border-radius:14px;background:white;padding:10px}.ev strong{display:block}.relationship{display:grid;grid-template-columns:34px 1fr;gap:10px;align-items:start;margin-top:9px}.icon{width:34px;height:34px;border-radius:12px;display:grid;place-items:center;background:#eaf3d0}.brain-flow{display:grid;grid-template-columns:repeat(6,1fr);gap:8px;align-items:stretch}.flow-step{padding:12px;border-radius:16px;background:#fffef8;border:1px solid var(--line);font-weight:800;text-align:center}.flow-arrow{display:grid;place-items:center;color:var(--moss);font-weight:900}.domain-bar{height:10px;border-radius:999px;background:#ecf1df;overflow:hidden}.domain-bar span{display:block;height:100%;background:linear-gradient(90deg,var(--moss),var(--lime))}footer{border-top:1px solid var(--line);margin-top:38px;padding:24px 0;color:var(--muted)}
    @media(max-width:920px){.hero,.two{grid-template-columns:1fr}.grid{grid-template-columns:repeat(2,1fr)}.brain-card{min-height:500px}.stats{grid-template-columns:repeat(2,1fr)}.evidence{grid-template-columns:1fr}.brain-flow{grid-template-columns:1fr}.flow-arrow{display:none}.ask{grid-template-columns:1fr}}
    @media(max-width:560px){.grid{grid-template-columns:1fr}.hero h1{font-size:44px}.brain-map{display:none}.hero-nodes{inset:170px 14px 120px}.stats{position:relative;left:auto;right:auto;bottom:auto;margin-top:310px}}
  </style>
</head>
<body>
  <main class="wrap">
    <section class="hero">
      <div>
        <span class="eyebrow">Ireland Public Context Brain</span>
        <h1>Ask anything. Get answers grounded in public evidence.</h1>
        <p class="lead">A living graph that connects places, issues, assets, events, candidate factors, datasets, time, confidence and missing evidence for AI agents and humans.</p>
        <p class="boundary"><strong>Boundary:</strong> the brain retrieves connected context and evidence. It does not issue official causation, blame, legal, engineering, safety or policy conclusions.</p>
        <div class="actions"><a class="button" href="#ask">Ask the brain</a><a class="button secondary" href="/mcp">Use via MCP</a><a class="button secondary" href="https://ireland-public-context-graph-mcp.amreshtech.workers.dev/api/brain">Brain API</a></div>
      </div>
      <div class="brain-card" aria-label="Public context brain illustration">
        <span class="eyebrow" style="background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.24)">Domain agnostic</span>
        <p style="font-size:21px;max-width:440px">Question → candidate factors → supporting datasets → confidence → missing evidence.</p>
        <div class="brain-map"><svg viewBox="0 0 230 170"><path d="M94 11c30 4 54 20 65 43 14 30 42 31 44 62 2 28-26 44-61 48-39 5-80-7-96-32-15-23 11-38 1-66C38 39 58 6 94 11Z" fill="#d7ee7f" opacity=".86"/><path d="M58 50c40 14 75 18 124 9M48 94c46-8 92 0 134 24M111 28c-7 38 7 76 35 116" stroke="#173c2b" stroke-width="5" opacity=".42" fill="none"/><circle cx="126" cy="82" r="8" fill="#d6804b"/><circle cx="86" cy="112" r="6" fill="#b9d8ef"/></svg></div>
        <div class="hero-nodes"><span class="hedge e1"></span><span class="hedge e2"></span><span class="hedge e3"></span><span class="hedge e4"></span><span class="hnode q">Question</span><span class="hnode a">Place</span><span class="hnode b">Factors</span><span class="hnode c">Evidence</span><span class="hnode d">Missing data</span></div>
        <div class="stats"><div class="stat"><b>{manifest.datasetCount?.toLocaleString?.() ?? manifest.datasetCount}</b><span>datasets</span></div><div class="stat"><b>{manifest.brainFactorCount ?? brain.factorCount}</b><span>factor types</span></div><div class="stat"><b>{manifest.brainEvidenceEdgeCount ?? brain.evidenceEdgeCount}</b><span>evidence edges</span></div><div class="stat"><b>{manifest.relationshipCount?.toLocaleString?.() ?? manifest.relationshipCount}</b><span>graph links</span></div></div>
      </div>
    </section>

    <section class="section-title"><div><h2>What this brain does</h2><p class="muted">It does not just list datasets. It connects real-world factors behind a question.</p></div></section>
    <section class="brain-flow"><div class="flow-step">Ask a civic question</div><div class="flow-arrow">→</div><div class="flow-step">Match issue type</div><div class="flow-arrow">→</div><div class="flow-step">Retrieve factors + evidence</div><div class="flow-step">Expose missing data</div></section>

    <section id="ask" class="section-title"><div><h2>Ask the brain</h2><p class="muted">Examples are backed by generated <code>brain-index.json</code>, not hard-coded prose.</p></div><span class="pill">{brain.issueCount} issue types · {brain.factorCount} factors</span></section>
    <section class="card flat">
      <div class="ask"><input id="q" value="Why is flooding happening in Tallaght?" placeholder="Ask: why is flooding happening here, is this road unsafe, what services are missing?"/><button class="button" id="askBtn">Ask</button></div>
      <div class="chips">{['Why is flooding happening in Tallaght?','Is this road unsafe near a school?','What public services are missing here?','What changed around this neighbourhood?','Which datasets support this claim?'].map(x => <button class="chip" data-question={x}>{x}</button>)}</div>
    </section>

    <section class="two" style="margin-top:16px">
      <div class="card flat"><h3>Matched context</h3><div id="issues" class="issue-list"></div></div>
      <div class="card"><div id="answer"></div></div>
    </section>

    <section class="section-title"><div><h2>Learning loop</h2><p class="muted">Learning means reconciling new public evidence, not hallucinating facts.</p></div></section>
    <section class="grid">{(brain.learningLoop ?? []).slice(0,6).map((step, i) => <div class="card flat"><span class="pill">Step {i+1}</span><p>{step}</p></div>)}</section>

    <section class="section-title"><div><h2>Coverage now</h2><p class="muted">Current domain coverage feeding the brain.</p></div></section>
    <section class="grid">{topDomains.map(([name,count]) => <div class="card flat"><strong>{name}</strong><p class="muted small">{Number(count).toLocaleString()} datasets</p><div class="domain-bar"><span style={`width:${Math.max(6, Math.round((Number(count)/Number(topDomains[0]?.[1] ?? 1))*100))}%`}></span></div></div>)}</section>

    <section class="section-title"><div><h2>Agent endpoints</h2><p class="muted">Claude/Hermes/Codex can query the same brain through MCP/API.</p></div></section>
    <section class="grid"><a class="card flat" href="https://ireland-public-context-graph-mcp.amreshtech.workers.dev/api/ask?q=Why%20is%20flooding%20happening%20in%20Tallaght">Ask API</a><a class="card flat" href="https://ireland-public-context-graph-mcp.amreshtech.workers.dev/api/brain">Brain index</a><a class="card flat" href="https://ireland-public-context-graph-mcp.amreshtech.workers.dev/artifacts/brain-index.json">Brain artifact</a><a class="card flat" href="/mcp">MCP instructions</a></section>
    <footer>Generated: {manifest.generatedAt}. Source: <a href="https://github.com/the-fluid-company/ireland-public-context-graph">GitHub</a>. Evidence/context only; no official conclusions.</footer>
  </main>
  <script is:inline>
    // @ts-nocheck
    const state = { brain:null };
    const q = document.getElementById('q'); const answer = document.getElementById('answer'); const issuesEl = document.getElementById('issues');
    function esc(s){return String(s ?? '').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
    function norm(s){return String(s ?? '').toLowerCase();}
    function scoreIssue(issue, query){const text=norm(`${issue.id} ${issue.label} ${(issue.examples||[]).join(' ')} ${(issue.factors||[]).map(f=>`${f.label} ${f.description} ${(f.keywords||[]).join(' ')}`).join(' ')}`); return norm(query).split(/[^a-z0-9-]+/).filter(Boolean).reduce((n,t)=>n+(text.includes(t)?(t.length>3?3:1):0), text.includes(norm(query))?10:0)}
    function rankedIssues(){const brain = state.brain || {issues:[]}; return [...(brain.issues||[])].map(issue=>({issue,score:scoreIssue(issue,q.value)})).sort((a,b)=>b.score-a.score)}
    function render(){const brain = state.brain || {issues:[]}; const ranked=rankedIssues(); const current=(ranked[0]?.score>0?ranked[0].issue:(brain.issues||[])[0]); issuesEl.innerHTML=(brain.issues||[]).map(issue=>`<button class="issue-btn ${issue.id===current?.id?'active':''}" data-id="${esc(issue.id)}"><strong>${esc(issue.label)}</strong><span class="muted small">${(issue.factors||[]).length} factors · ${(issue.examples||[])[0]||''}</span></button>`).join(''); issuesEl.querySelectorAll('button').forEach(b=>b.onclick=()=>renderIssue((brain.issues||[]).find(i=>i.id===b.dataset.id))); renderIssue(current)}
    function renderIssue(issue){ if(!issue){answer.innerHTML='<p>No brain index loaded.</p>';return;} const factors=(issue.factors||[]); const strong=factors.filter(f=>f.strongestEvidence==='strong').length; const evidenceTotal=factors.reduce((n,f)=>n+(f.evidenceCount||0),0); answer.innerHTML=`<span class="pill">Matched: ${esc(issue.label)}</span><h3 style="font-family:Georgia,'Times New Roman',serif;font-size:34px;margin:10px 0">Candidate factor graph</h3><p class="muted">${esc(issue.agentPrompt || 'Evidence graph only; no official conclusions.')}</p><div class="card flat" style="margin:12px 0;background:#f6faea"><strong>Summary:</strong> ${factors.length} candidate factors · ${strong} strong evidence groups · ${evidenceTotal} supporting dataset links · ${(issue.missingEvidence||[]).length || 'no complete'} missing factor classes. Use this as context, not as a formal conclusion.</div><div class="factor-list">${factors.map(f=>`<div class="factor"><div class="factor-head"><strong>${esc(f.label)}</strong><span class="strength ${esc(f.strongestEvidence)}">${esc(f.strongestEvidence)}</span></div><div class="relationship"><div class="icon">↔</div><div><strong>${esc(f.relationship)}</strong><br/><span class="muted small">${esc(f.description)}</span></div></div><p class="small"><strong>Needs:</strong> ${(f.requiredEvidence||[]).map(esc).join(' · ')}</p><div class="evidence">${(f.evidenceDatasets||[]).slice(0,2).map(e=>`<a class="ev" href="${esc(e.sourceUrl)}" target="_blank" rel="noreferrer"><strong>${esc(e.title)}</strong><span class="muted small">${esc(e.publisher)} · ${esc(e.evidenceStrength)} · score ${e.score}</span><p class="small">${(e.reasons||[]).map(esc).join(' · ')}</p></a>`).join('') || `<div class="ev"><strong>Missing evidence</strong><p class="small">${esc(f.missingIfAbsent)}</p></div>`}</div></div>`).join('')}</div><h3>Missing evidence</h3><ul>${(issue.missingEvidence||[]).map(x=>`<li>${esc(x)}</li>`).join('') || '<li>No completely missing factor class in this indexed release; still verify source caveats.</li>'}</ul>`;}
    document.getElementById('askBtn').onclick=render; q.addEventListener('keydown',e=>{if(e.key==='Enter')render()}); document.querySelectorAll('[data-question]').forEach(b=>b.onclick=()=>{q.value=b.dataset.question;render()});
    fetch('/data/brain-index.json').then(r=>r.json()).then(data=>{state.brain=data;render()}).catch(()=>{answer.innerHTML='<p>Brain index failed to load.</p>'});
  </script>
</body>
</html>
