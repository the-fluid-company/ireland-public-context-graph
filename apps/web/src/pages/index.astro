---
const manifest = await import('../../public/data/manifest.json').then(m => m.default).catch(() => ({ generatedAt:'pending', datasetCount:0, publisherCount:0, realWorldNodeCount:0, realWorldRelationshipCount:0, brainIssueCount:0, brainFactorCount:0, brainEvidenceEdgeCount:0 }));
const brain = await import('../../public/data/brain-index.json').then(m => m.default).catch(() => ({ issues:[], issueCount:0, factorCount:0, evidenceEdgeCount:0 }));
const updatedLabel = (() => {
  const d = new Date(manifest.generatedAt);
  if (Number.isNaN(d.getTime())) return 'update pending';
  return new Intl.DateTimeFormat('en-IE', { day:'numeric', month:'short', hour:'2-digit', minute:'2-digit', timeZone:'UTC', timeZoneName:'short' }).format(d);
})();
const layers = [
  { group:'Weather & water', items:['Rainfall','Rivers / streams','Ground already soaked','Flood zones'], active:3, total:4 },
  { group:'Roads & safety', items:['Roads','School zones','Collisions','Crossings'], active:2, total:4 },
  { group:'Places & services', items:['Schools','Health services','Public facilities','Population'], active:3, total:4 },
  { group:'Planning context', items:['Planning applications','Housing','Land use','Transport access'], active:2, total:4 }
];
const examples = ['Why is flooding happening in Tallaght?','Is this road dangerous near a school?','What services are missing nearby?','What changed in this area?'];
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Ireland Public Context Map</title>
  <meta name="description" content="A map-first public data explorer for ordinary people to see how Irish places, public sources and possible reasons connect." />
  <style>
    :root{--bg:#f6f3e8;--panel:rgba(255,255,252,.88);--panel2:rgba(255,255,255,.96);--line:rgba(27,100,91,.22);--line2:rgba(27,100,91,.12);--text:#102623;--muted:#5c716d;--cyan:#087f72;--blue:#266fb4;--amber:#b46f06;--green:#278b51;--orange:#c45d2c;--purple:#6e59b7;--danger:#bd3d52;--shadow:0 24px 70px rgba(20,55,48,.14);font-family:"Aptos","Segoe UI",system-ui,sans-serif;color:var(--text);background:var(--bg)}
    *{box-sizing:border-box} body{margin:0;min-height:100vh;background:radial-gradient(circle at 48% 38%,rgba(8,127,114,.12),transparent 23rem),radial-gradient(circle at 74% 65%,rgba(38,111,180,.1),transparent 26rem),linear-gradient(135deg,#fbfaf2,#eef5ee);overflow-x:hidden} button,input{font:inherit} button{cursor:pointer} a{color:var(--cyan)}
    .shell{min-height:100vh;display:grid;grid-template-rows:auto 1fr auto;position:relative;isolation:isolate}.map{position:fixed;inset:0;z-index:-2;background:linear-gradient(135deg,#f9f7ec,#e7f2ee)}.map:before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(27,100,91,.08) 1px,transparent 1px),linear-gradient(90deg,rgba(27,100,91,.07) 1px,transparent 1px);background-size:54px 54px;mask-image:radial-gradient(circle at center,#000 20%,transparent 82%)}.map:after{content:"";position:absolute;inset:0;background:radial-gradient(circle at 28% 42%,rgba(39,139,81,.38) 0 4px,transparent 5px),radial-gradient(circle at 42% 33%,rgba(180,111,6,.38) 0 5px,transparent 6px),radial-gradient(circle at 55% 57%,rgba(8,127,114,.45) 0 6px,transparent 7px),radial-gradient(circle at 63% 39%,rgba(196,93,44,.36) 0 5px,transparent 6px),radial-gradient(circle at 71% 61%,rgba(110,89,183,.34) 0 5px,transparent 6px),radial-gradient(circle at 38% 70%,rgba(38,111,180,.34) 0 5px,transparent 6px));filter:drop-shadow(0 0 9px rgba(8,127,114,.35))}.ireland-map{position:fixed;left:38%;top:16%;width:min(48vw,620px);height:auto;opacity:.72;z-index:-1;filter:drop-shadow(0 22px 44px rgba(27,100,91,.13))}.route{stroke-dasharray:6 10;animation:dash 18s linear infinite}@keyframes dash{to{stroke-dashoffset:-220}}
    .topbar{display:grid;grid-template-columns:280px 1fr minmax(440px,520px);gap:14px;align-items:center;padding:14px 16px 8px}.brand,.status,.search{border:1px solid var(--line);background:linear-gradient(180deg,rgba(255,255,255,.94),rgba(248,250,244,.84));box-shadow:var(--shadow);backdrop-filter:blur(14px);border-radius:18px}.brand{padding:14px 16px}.brand h1{margin:0;font-size:32px;letter-spacing:.04em;line-height:.85}.brand p{margin:7px 0 0;color:var(--muted);font:800 11px ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.16em;text-transform:uppercase}.status{display:flex;justify-content:center;gap:18px;padding:12px 16px;font:800 12px ui-monospace,SFMono-Regular,Menlo,monospace;text-transform:uppercase;color:var(--muted)}.status b{color:var(--cyan)}.status .live{color:var(--green)}.search{padding:10px;display:flex;gap:8px}.search input{width:100%;border:1px solid rgba(27,100,91,.18);background:rgba(255,255,255,.78);color:var(--text);border-radius:13px;padding:12px 13px;outline:0}.search input:focus{border-color:var(--cyan);box-shadow:0 0 0 3px rgba(8,127,114,.12)}.search button,.primary{border:0;background:var(--cyan);color:white;border-radius:13px;padding:11px 14px;font:950 12px ui-monospace,SFMono-Regular,Menlo,monospace;text-transform:uppercase;white-space:nowrap}
    .workspace{display:grid;grid-template-columns:330px 1fr 390px;gap:14px;padding:8px 16px 12px;min-height:calc(100vh - 142px)}.panel{border:1px solid var(--line);background:var(--panel);backdrop-filter:blur(16px);box-shadow:var(--shadow);border-radius:22px;overflow:hidden}.panel-head{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:14px 15px;border-bottom:1px solid var(--line2);font:900 12px ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.14em;text-transform:uppercase;color:#173c36}.count{color:var(--cyan)}.layer-body{padding:10px;display:grid;gap:10px}.layer-group{border:1px solid rgba(27,100,91,.12);background:rgba(255,255,255,.58);border-radius:16px;overflow:hidden}.group-title{display:flex;justify-content:space-between;align-items:center;padding:11px 12px;color:#173c36;font-weight:850}.group-title span{font:800 11px ui-monospace,SFMono-Regular,Menlo,monospace;color:var(--amber)}.layer{display:flex;align-items:center;justify-content:space-between;padding:9px 12px;border-top:1px solid rgba(27,100,91,.1);color:var(--muted);font-size:14px}.toggle{width:34px;height:18px;border-radius:999px;background:rgba(27,100,91,.14);position:relative}.toggle:after{content:"";position:absolute;top:3px;left:3px;width:12px;height:12px;border-radius:50%;background:#8c9d99}.layer.on{color:var(--text)}.layer.on .toggle{background:rgba(8,127,114,.2)}.layer.on .toggle:after{left:19px;background:var(--cyan);box-shadow:0 0 10px rgba(8,127,114,.35)}
    .center{display:flex;align-items:end;justify-content:center;position:relative}.hero-card{width:min(620px,100%);margin-bottom:18px;border:1px solid var(--line);background:linear-gradient(180deg,rgba(255,255,252,.84),rgba(245,250,246,.9));backdrop-filter:blur(18px);border-radius:30px;box-shadow:var(--shadow);padding:20px}.hero-card .kicker{font:900 12px ui-monospace,SFMono-Regular,Menlo,monospace;color:var(--cyan);letter-spacing:.18em;text-transform:uppercase}.hero-card h2{font-size:clamp(34px,4.8vw,58px);line-height:.9;letter-spacing:-.06em;margin:12px 0 14px}.hero-card p{font-size:16px;color:#35534e;max-width:680px;margin:0}.chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:18px}.chip{border:1px solid rgba(8,127,114,.24);background:rgba(8,127,114,.08);color:#113f38;border-radius:999px;padding:9px 12px;font-size:13px}.map-label{position:absolute;border:1px solid var(--line);background:rgba(255,255,252,.78);backdrop-filter:blur(10px);border-radius:14px;padding:9px 11px;font:800 12px ui-monospace,SFMono-Regular,Menlo,monospace;color:var(--cyan);box-shadow:0 14px 30px rgba(27,100,91,.1)}.label-a{left:10%;top:17%}.label-b{right:18%;top:35%;color:var(--amber)}.label-c{left:25%;bottom:32%;color:var(--green)}
    .right{display:grid;grid-template-rows:auto 1fr;gap:14px}.tools{padding-bottom:12px}.tool-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;padding:12px}.tool{border:1px solid rgba(27,100,91,.12);background:rgba(255,255,255,.58);border-radius:16px;padding:12px;color:var(--text);min-height:76px}.tool b{display:block;color:var(--cyan);font:900 11px ui-monospace,SFMono-Regular,Menlo,monospace;text-transform:uppercase;letter-spacing:.1em}.tool span{display:block;color:var(--muted);font-size:13px;margin-top:5px}.answer{padding:14px;overflow:auto}.answer-kicker{display:flex;justify-content:space-between;gap:10px;align-items:center;margin:-14px -14px 14px;padding:13px 14px;border-bottom:1px solid var(--line2);font:900 11px ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.13em;text-transform:uppercase;color:#173c36}.answer-kicker b{color:var(--cyan);font:inherit}.answer-title{font-size:31px;line-height:1;margin:0 0 10px;letter-spacing:-.04em}.summary{border:1px solid rgba(8,127,114,.18);background:rgba(8,127,114,.07);border-radius:18px;padding:13px;color:#1c4c44;margin:10px 0 12px}.trail{list-style:none;padding:0;margin:10px 0;display:grid;gap:8px}.trail li{border:1px solid rgba(27,100,91,.12);background:rgba(255,255,255,.68);border-radius:15px;padding:11px;color:#243f3a}.trail b{color:var(--cyan)}.reason-list{display:grid;gap:9px;margin-top:12px}.reason{border:1px solid rgba(27,100,91,.12);background:rgba(255,255,255,.7);border-radius:16px;padding:12px}.reason h4{margin:0;color:#102623;font-size:17px}.reason p{margin:6px 0 0;color:var(--muted);font-size:13px}.badge{float:right;border:1px solid rgba(39,139,81,.25);background:rgba(39,139,81,.09);color:#1f743f;border-radius:999px;padding:4px 7px;font:900 10px ui-monospace,SFMono-Regular,Menlo,monospace;text-transform:uppercase}.sources summary{margin-top:8px;color:var(--cyan);font:900 12px ui-monospace,SFMono-Regular,Menlo,monospace;cursor:pointer}.source-link{display:block;margin-top:7px;border-left:3px solid var(--cyan);padding:8px 9px;background:rgba(8,127,114,.05);border-radius:0 10px 10px 0;text-decoration:none;color:#143d37}.source-link span{color:var(--muted);font-size:12px}.empty{color:var(--muted)}
    .bottombar{display:grid;grid-template-columns:repeat(7,1fr);gap:8px;padding:0 16px 14px}.metric{border:1px solid var(--line);background:rgba(255,255,252,.86);backdrop-filter:blur(12px);border-radius:16px;padding:10px 12px;text-decoration:none}.metric span{display:block;color:var(--muted);font:850 10px ui-monospace,SFMono-Regular,Menlo,monospace;text-transform:uppercase;letter-spacing:.13em}.metric b{display:block;color:var(--text);font-size:20px;margin-top:2px}.dev{display:none}.dev summary{list-style:none;border:1px solid var(--line);background:rgba(255,255,252,.9);border-radius:999px;padding:9px 12px;font:900 11px ui-monospace,SFMono-Regular,Menlo,monospace;text-transform:uppercase;color:var(--muted);cursor:pointer}.dev-links{margin-top:8px;background:var(--panel2);border:1px solid var(--line);border-radius:16px;padding:10px;display:grid;gap:8px}.dev-links a{font-size:13px;text-decoration:none}.mobile-note{display:none}
    @media(max-width:1100px){body{overflow:auto}.topbar,.workspace{grid-template-columns:1fr}.workspace{min-height:auto}.left{order:2}.center{min-height:520px;order:1}.right{order:3}.bottombar{grid-template-columns:repeat(2,1fr)}.ireland-map{left:12%;top:18%;width:76vw}.status{justify-content:flex-start;overflow:auto}.dev{position:static;margin:0 16px 14px}.map-label{display:none}}
    @media(max-width:620px){.topbar,.workspace{padding-left:10px;padding-right:10px}.brand h1{font-size:25px}.search{flex-direction:column}.hero-card{padding:20px}.hero-card h2{font-size:42px}.bottombar{grid-template-columns:1fr}.tool-grid{grid-template-columns:1fr}.mobile-note{display:block;color:var(--muted);font-size:13px;margin-top:10px}}
  </style>
</head>
<body>
  <main class="shell">
    <div class="map" aria-hidden="true"></div>
    <svg class="ireland-map" viewBox="0 0 520 620" aria-hidden="true">
      <path d="M284 12c63 25 55 80 94 111 39 31 96 26 112 79 15 49-31 78-22 126 10 65 67 100 39 158-25 53-91 43-132 80-43 39-48 100-116 101-60 1-76-59-122-80-49-22-116 1-143-52-29-55 24-97 35-154 12-58-29-116 1-166 33-54 103-42 148-81 45-40 36-146 106-122Z" fill="rgba(255,255,252,.46)" stroke="rgba(8,127,114,.48)" stroke-width="3" />
      <path class="route" d="M98 192c89 31 183 40 294 21M73 336c118-22 246-3 365 60M207 124c-20 119 31 240 133 369" fill="none" stroke="rgba(38,111,180,.32)" stroke-width="8" stroke-linecap="round" />
      <circle cx="265" cy="292" r="9" fill="#087f72"><animate attributeName="r" values="7;15;7" dur="2.8s" repeatCount="indefinite" /></circle>
    </svg>

    <header class="topbar">
      <section class="brand"><h1>IRELAND<br/>CONTEXT</h1><p>Public data situational map</p></section>
      <section class="status"><span>SYS: <b class="live">LIVE</b></span><span>Sources: <b>{manifest.publisherCount}</b></span><span>Updated: <b>{updatedLabel}</b></span><span>Advisory: <b>Context only</b></span></section>
      <section class="search"><input id="q" value="Why is flooding happening in Tallaght?" aria-label="Ask about a place or issue" /><button id="askBtn">Map context</button></section>
    </header>

    <section class="workspace">
      <aside class="panel left">
        <div class="panel-head"><span>Public data layers</span><span class="count">10 / 16</span></div>
        <div class="layer-body">
          {layers.map(group => <div class="layer-group"><div class="group-title">{group.group}<span>{group.active}/{group.total}</span></div>{group.items.map((item, i) => <div class:list={['layer', i < group.active && 'on']}><span>{item}</span><span class="toggle" aria-hidden="true"></span></div>)}</div>)}
        </div>
      </aside>

      <section class="center">
        <span class="map-label label-a">Schools + roads</span>
        <span class="map-label label-b">Rain + rivers</span>
        <span class="map-label label-c">Public services</span>
        <div class="hero-card">
          <div class="kicker">For ordinary people, not data engineers</div>
          <h2>See what public data says about a place.</h2>
          <p>Choose a question, turn public layers on and off, then inspect the evidence trail: what place you asked about, what possible reasons may matter, and which public records support the context.</p>
          <div class="chips">{examples.map(x => <button class="chip" data-question={x}>{x}</button>)}</div>
          <p class="mobile-note">On desktop this behaves like an operations map. On mobile, panels stack into a simple evidence reader.</p>
        </div>
      </section>

      <aside class="right">
        <section class="panel tools">
          <div class="panel-head"><span>Explorer tools</span><span class="count">plain English</span></div>
          <div class="tool-grid">
            <button class="tool"><b>Explain area</b><span>Summarise possible public context.</span></button>
            <button class="tool"><b>Show evidence</b><span>Open source links and caveats.</span></button>
            <button class="tool"><b>Find nearby</b><span>Schools, services, roads, rivers.</span></button>
            <button class="tool"><b>What's missing</b><span>See weak or absent evidence.</span></button>
          </div>
        </section>
        <section class="panel answer" id="answer"><p class="empty">Loading public context…</p></section>
      </aside>
    </section>

    <section class="bottombar" aria-label="Public graph summary">
      <div class="metric"><span>Datasets</span><b>{manifest.datasetCount?.toLocaleString?.() ?? manifest.datasetCount}</b></div>
      <div class="metric"><span>Real-world nodes</span><b>{manifest.realWorldNodeCount?.toLocaleString?.() ?? manifest.realWorldNodeCount}</b></div>
      <div class="metric"><span>Relationships</span><b>{manifest.realWorldRelationshipCount?.toLocaleString?.() ?? manifest.realWorldRelationshipCount}</b></div>
      <div class="metric"><span>Question types</span><b>{manifest.brainIssueCount ?? brain.issueCount}</b></div>
      <div class="metric"><span>Possible reasons</span><b>{manifest.brainFactorCount ?? brain.factorCount}</b></div>
      <div class="metric"><span>Evidence links</span><b>{manifest.brainEvidenceEdgeCount ?? brain.evidenceEdgeCount}</b></div>
      <a class="metric dev-metric" href="/mcp"><span>Developer</span><b>API / MCP</b></a>
    </section>

    <details class="dev"><summary>Developer access</summary><div class="dev-links"><a href="https://ireland-public-context-graph-mcp.amreshtech.workers.dev/api/ask?q=Why%20is%20flooding%20happening%20in%20Tallaght">Ask API</a><a href="https://ireland-public-context-graph-mcp.amreshtech.workers.dev/api/real-world-graph?q=school&limit=10">Graph API</a><a href="/mcp">MCP instructions</a><a href="https://github.com/the-fluid-company/ireland-public-context-graph">GitHub</a></div></details>
  </main>

  <script is:inline>
    // @ts-nocheck
    const state = { brain:null, selected:null };
    const q = document.getElementById('q');
    const answer = document.getElementById('answer');
    const norm = s => String(s ?? '').toLowerCase();
    const esc = s => String(s ?? '').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    function simpleFactorLabel(label){
      const map = {'Rainfall intensity and duration':'Heavy rain','River level and upstream/downstream cascade':'Rivers and streams rising','Soil saturation and infiltration capacity':'Ground already soaked','Elevation, slope and flow paths':'Low ground and slopes','Impervious surface and land cover':'Concrete, roads and hard surfaces','Drainage, culverts and road barriers':'Drains, culverts and road layout'};
      return map[label] || label;
    }
    function strengthText(s){ return s === 'strong' ? 'strong evidence' : s === 'medium' ? 'some evidence' : s === 'weak' ? 'limited evidence' : 'evidence unclear'; }
    function scoreIssue(issue, query){
      const text = norm(`${issue.id} ${issue.label} ${(issue.examples||[]).join(' ')} ${(issue.factors||[]).map(f=>`${f.label} ${f.description} ${(f.keywords||[]).join(' ')}`).join(' ')}`);
      return norm(query).split(/[^a-z0-9-]+/).filter(Boolean).reduce((n,t)=>n+(text.includes(t)?(t.length>3?3:1):0), text.includes(norm(query))?10:0);
    }
    function chooseIssue(){
      const issues = state.brain?.issues || [];
      const ranked = [...issues].map(issue=>({issue,score:scoreIssue(issue,q.value)})).sort((a,b)=>b.score-a.score);
      return ranked[0]?.score > 0 ? ranked[0].issue : issues[0];
    }
    function inferredPlace(query){
      const known = ['Tallaght','Dublin','Cork','Galway','Limerick','Waterford','Sligo','Fingal','South Dublin','Dún Laoghaire','Kerry','Mayo'];
      return known.find(place => norm(query).includes(norm(place))) || 'your place';
    }
    function render(){
      const issue = chooseIssue();
      if(!issue){ answer.innerHTML = '<p class="empty">No public context loaded yet.</p>'; return; }
      const factors = issue.factors || [];
      const top = factors[0] || {};
      const source = (top.evidenceDatasets||[])[0] || {};
      const place = inferredPlace(q.value);
      const reason = simpleFactorLabel(top.label || 'a possible reason');
      const names = factors.slice(0,4).map(f => String(simpleFactorLabel(f.label)||'').toLowerCase());
      answer.innerHTML = `
        <div class="answer-kicker"><span>Selected context:</span><b>${esc(place)}</b></div>
        <h2 class="answer-title">${esc(String(issue.label || '').replace(/ context$/i,''))}</h2>
        <div class="summary">This question may be related to ${esc(names.join(', '))}. These are possible reasons to investigate, not official conclusions.</div>
        <ul class="trail">
          <li><b>Your question:</b> asks about ${esc(place)}.<br/><span>${esc(q.value)}</span></li>
          <li><b>One possible reason:</b> ${esc(reason.toLowerCase())} could be part of the context.<br/><span>This is a lead to inspect, not a final answer.</span></li>
          <li><b>Evidence to inspect:</b> ${esc(source.title || 'a linked public source')}.<br/><span>Published by ${esc(source.publisher || 'a public body')}.</span></li>
        </ul>
        <div class="reason-list">
          ${factors.slice(0,3).map(f => `<article class="reason"><span class="badge">${esc(strengthText(f.strongestEvidence))}</span><h4>${esc(simpleFactorLabel(f.label))}</h4><p>${esc(f.description || 'This may be relevant to the question.')}</p><details class="sources"><summary>Show public sources</summary>${(f.evidenceDatasets||[]).slice(0,3).map(e => `<a class="source-link" href="${esc(e.sourceUrl)}" target="_blank" rel="noreferrer"><strong>${esc(e.title)}</strong><br/><span>${esc(e.publisher)} · ${esc(e.license || 'licence to verify')}</span></a>`).join('') || '<p class="empty">No strong public source linked yet.</p>'}</details></article>`).join('')}
        </div>`;
    }
    document.getElementById('askBtn').onclick = () => render();
    q.addEventListener('keydown', e => { if(e.key === 'Enter') render(); });
    document.querySelectorAll('[data-question]').forEach(b => b.onclick = () => { q.value = b.dataset.question; render(); });
    fetch('/data/brain-index.json').then(r=>r.json()).then(data=>{state.brain=data;render();}).catch(()=>{answer.innerHTML='<p class="empty">Brain data failed to load.</p>';});
  </script>
</body>
</html>
