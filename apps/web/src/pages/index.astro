---
const manifest = await import('../../public/data/manifest.json').then(m => m.default).catch(() => ({ generatedAt:'pending', datasetCount:0, publisherCount:0, realWorldNodeCount:0, realWorldRelationshipCount:0, brainIssueCount:0, brainFactorCount:0, brainEvidenceEdgeCount:0, globalSignalSourceCount:0, causalToolingCount:0, housingPlanningLayerCount:0, housingPlanningFeatureCount:0 }));
const updatedLabel = (() => {
  const d = new Date(manifest.generatedAt);
  if (Number.isNaN(d.getTime())) return 'update pending';
  return new Intl.DateTimeFormat('en-IE', { day:'numeric', month:'short', hour:'2-digit', minute:'2-digit', timeZone:'UTC', timeZoneName:'short' }).format(d);
})();
const layers = [
  { id:'flood', group:'Water & flooding', items:['Rainfall context','Rivers & drainage','Flood records','Ground conditions'], domains:['weather','environment','infrastructure'], color:'#087f72' },
  { id:'roads', group:'Roads & safety', items:['Road network','School zones','Collisions','Traffic counters'], domains:['roads','transport','collisions'], color:'#266fb4' },
  { id:'services', group:'Public services', items:['Schools','Health services','Public facilities','Population need'], domains:['education','health','public-services','demographics'], color:'#278b51' },
  { id:'planning', group:'Planning & change', items:['Planning applications','Housing','Land use','Infrastructure works'], domains:['planning','housing','local-government','energy'], color:'#b46f06' },
  { id:'signals', group:'Global signals & causality', items:['NASA/Data Commons/GDELT','Movement','Research graph','Causal tools'], domains:['economy','environment','health','transport'], color:'#7c3aed' }
];
const examples = ['Tallaght flooding','road danger near a school','public services in Galway','planning changes near Dublin'];
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Ireland Public Context Map</title>
  <meta name="description" content="A real map-first public context explorer for ordinary people to see how Irish places, public data layers and evidence relationships connect." />
  <link rel="stylesheet" href="https://unpkg.com/maplibre-gl@5.9.0/dist/maplibre-gl.css" />
  <script src="https://unpkg.com/maplibre-gl@5.9.0/dist/maplibre-gl.js"></script>
  <style>
    :root{--bg:#f5f2e8;--panel:rgba(255,255,251,.92);--panel2:#fffffb;--line:rgba(20,84,78,.22);--line2:rgba(20,84,78,.12);--text:#102623;--muted:#657771;--teal:#087f72;--blue:#266fb4;--green:#278b51;--amber:#b46f06;--red:#bd3d52;--shadow:0 22px 70px rgba(17,55,48,.18);font-family:"Aptos","Segoe UI",system-ui,sans-serif;color:var(--text);background:var(--bg)}
    *{box-sizing:border-box} body{margin:0;min-height:100vh;overflow:hidden;background:var(--bg)} button,input{font:inherit} button{cursor:pointer} a{color:var(--teal)}
    #map{position:fixed;inset:0;background:#edf2ea}.maplibregl-ctrl-bottom-left,.maplibregl-ctrl-bottom-right{display:none}.maplibregl-popup-content{border-radius:14px;border:1px solid var(--line);box-shadow:var(--shadow);padding:0;background:var(--panel2);color:var(--text)}
    .app{position:relative;z-index:2;min-height:100vh;display:grid;grid-template-rows:auto 1fr auto;pointer-events:none}.topbar,.workspace,.bottombar,.dev{pointer-events:none}.topbar>* ,.workspace>* ,.bottombar>* ,.dev{pointer-events:auto}
    .topbar{display:grid;grid-template-columns:260px minmax(340px,1fr) minmax(360px,520px);gap:12px;align-items:center;padding:12px}.brand,.status,.search,.panel,.metric,.dev{border:1px solid var(--line);background:linear-gradient(180deg,rgba(255,255,251,.96),rgba(248,250,244,.9));box-shadow:var(--shadow);backdrop-filter:blur(16px);border-radius:18px}.brand{padding:12px 14px}.brand h1{margin:0;font-size:28px;line-height:.9;letter-spacing:-.03em}.brand p{margin:6px 0 0;color:var(--muted);font:850 10px ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.16em;text-transform:uppercase}.status{display:flex;gap:16px;align-items:center;justify-content:center;min-height:60px;padding:10px 14px;color:var(--muted);font:850 11px ui-monospace,SFMono-Regular,Menlo,monospace;text-transform:uppercase;overflow:hidden}.status b{color:var(--teal)}.status .live{color:var(--green)}
    .search{display:flex;gap:8px;padding:9px}.search input{width:100%;border:1px solid rgba(20,84,78,.18);background:rgba(255,255,255,.82);border-radius:13px;padding:12px;outline:0;color:var(--text)}.search input:focus{border-color:var(--teal);box-shadow:0 0 0 3px rgba(8,127,114,.13)}.search button,.primary{border:0;background:var(--teal);color:white;border-radius:13px;padding:11px 14px;font:950 11px ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.06em;text-transform:uppercase;white-space:nowrap}
    .workspace{display:grid;grid-template-columns:330px 1fr 410px;gap:12px;padding:0 12px 10px;min-height:0}.center{position:relative;min-width:0}.panel{overflow:hidden}.panel-head{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:13px 14px;border-bottom:1px solid var(--line2);font:900 11px ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.13em;text-transform:uppercase;color:#173c36}.count{color:var(--teal)}
    .left,.right{align-self:start;max-height:calc(100vh - 154px);display:grid;gap:10px}.left{overflow:auto}.right{grid-template-rows:auto minmax(300px,1fr);overflow:hidden}.panel-body{padding:10px;display:grid;gap:9px}.layer-group{border:1px solid rgba(20,84,78,.12);background:rgba(255,255,255,.62);border-radius:16px;overflow:hidden}.layer-title{display:flex;align-items:center;justify-content:space-between;padding:11px 12px;font-weight:850}.layer-title span{display:inline-flex;align-items:center;gap:7px}.dot{width:10px;height:10px;border-radius:50%;background:var(--teal);box-shadow:0 0 0 4px rgba(8,127,114,.09)}.layer-title small{font:850 10px ui-monospace,SFMono-Regular,Menlo,monospace;color:var(--amber)}.layer-items{padding:0 12px 11px;color:var(--muted);font-size:13px;line-height:1.5}.layer-toggle{width:100%;border:0;background:transparent;color:inherit;text-align:left;padding:0}.layer-group.off{opacity:.52}.switch{width:38px;height:20px;border-radius:999px;background:rgba(20,84,78,.14);position:relative}.switch:after{content:"";position:absolute;top:3px;left:3px;width:14px;height:14px;border-radius:50%;background:#8fa19c;transition:.2s}.layer-group:not(.off) .switch{background:rgba(8,127,114,.22)}.layer-group:not(.off) .switch:after{left:21px;background:var(--teal);box-shadow:0 0 10px rgba(8,127,114,.3)}
    .map-help{position:absolute;left:50%;bottom:18px;transform:translateX(-50%);width:min(680px,92%);border:1px solid var(--line);background:rgba(255,255,251,.87);backdrop-filter:blur(16px);box-shadow:var(--shadow);border-radius:24px;padding:16px;pointer-events:auto}.map-help h2{margin:0 0 8px;font-size:34px;line-height:.95;letter-spacing:-.05em}.map-help p{margin:0;color:#36524d;line-height:1.45}.chips{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.chip{border:1px solid rgba(8,127,114,.25);background:rgba(8,127,114,.08);color:#113f38;border-radius:999px;padding:8px 11px;font-size:12px}.coords{position:absolute;right:10px;bottom:10px;padding:7px 9px;border:1px solid var(--line);background:rgba(255,255,251,.84);border-radius:999px;font:800 10px ui-monospace,SFMono-Regular,Menlo,monospace;color:var(--muted);pointer-events:auto}
    .tool-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;padding:10px}.tool{border:1px solid rgba(20,84,78,.12);background:rgba(255,255,255,.62);border-radius:15px;padding:11px;text-align:left;color:var(--text);min-height:70px}.tool b{display:block;color:var(--teal);font:900 10px ui-monospace,SFMono-Regular,Menlo,monospace;text-transform:uppercase;letter-spacing:.1em}.tool span{display:block;color:var(--muted);font-size:12px;margin-top:5px}.answer{overflow:auto;min-height:0}.answer-inner{padding:14px}.kicker{display:flex;justify-content:space-between;gap:10px;color:var(--muted);font:900 10px ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.13em;text-transform:uppercase}.kicker b{color:var(--teal)}.answer h2{margin:9px 0 8px;font-size:30px;line-height:1;letter-spacing:-.04em}.summary{border:1px solid rgba(8,127,114,.18);background:rgba(8,127,114,.07);border-radius:17px;padding:12px;color:#1c4c44;line-height:1.4}.relationship{margin-top:12px;display:grid;gap:8px}.rel-row{display:grid;grid-template-columns:24px 1fr;gap:9px;align-items:start;border:1px solid rgba(20,84,78,.12);background:rgba(255,255,255,.68);border-radius:15px;padding:10px;color:#274640}.rel-row i{display:grid;place-items:center;width:24px;height:24px;border-radius:999px;background:rgba(8,127,114,.1);color:var(--teal);font-style:normal;font-weight:900}.rel-row span{display:block;color:var(--muted);font-size:12px;margin-top:2px}.reason-list{display:grid;gap:8px;margin-top:12px}.reason{border:1px solid rgba(20,84,78,.12);background:rgba(255,255,255,.7);border-radius:15px;padding:11px}.reason h3{font-size:16px;margin:0}.reason p{margin:5px 0 0;color:var(--muted);font-size:13px}.badge{float:right;border:1px solid rgba(39,139,81,.25);background:rgba(39,139,81,.09);color:#1f743f;border-radius:999px;padding:4px 7px;font:900 9px ui-monospace,SFMono-Regular,Menlo,monospace;text-transform:uppercase}.sources summary{margin-top:8px;color:var(--teal);font:900 11px ui-monospace,SFMono-Regular,Menlo,monospace;cursor:pointer}.source-link{display:block;margin-top:7px;border-left:3px solid var(--teal);padding:7px 9px;background:rgba(8,127,114,.06);border-radius:10px;text-decoration:none}.source-link strong{font-size:12px}.source-link span{font-size:11px;color:var(--muted)}.empty{color:var(--muted);line-height:1.5}.pill-row{display:flex;flex-wrap:wrap;gap:7px;margin-top:10px}.pill{border:1px solid var(--line2);background:rgba(255,255,255,.64);border-radius:999px;padding:6px 8px;color:var(--muted);font:850 10px ui-monospace,SFMono-Regular,Menlo,monospace;text-transform:uppercase}
    .bottombar{display:grid;grid-template-columns:repeat(8,1fr);gap:8px;padding:0 12px 12px}.metric{padding:9px 11px;text-decoration:none}.metric span{display:block;color:var(--muted);font:850 9px ui-monospace,SFMono-Regular,Menlo,monospace;text-transform:uppercase;letter-spacing:.13em}.metric b{display:block;color:var(--text);font-size:18px;margin-top:2px}.dev{display:none;position:absolute;right:12px;bottom:64px;padding:8px 10px;font:900 10px ui-monospace,SFMono-Regular,Menlo,monospace;text-transform:uppercase;color:var(--muted)}
    .popup{padding:11px;max-width:260px}.popup b{display:block;color:var(--teal);font-size:14px}.popup span{display:block;color:var(--muted);font-size:12px;margin-top:4px}.popup button{margin-top:9px;border:0;border-radius:10px;background:var(--teal);color:white;padding:7px 9px;font:900 10px ui-monospace,SFMono-Regular,Menlo,monospace;text-transform:uppercase}
    @media(max-width:1150px){body{overflow:auto}.app{display:block}.topbar,.workspace,.bottombar{grid-template-columns:1fr}.workspace{padding:0 10px 10px}.left,.right{max-height:none}.center{height:560px;order:-1}.map-help{position:absolute}.bottombar{grid-template-columns:repeat(2,1fr)}#map{position:absolute;height:560px;top:210px}.topbar{padding:10px}.status{justify-content:flex-start;overflow:auto}.dev{position:static;margin:0 10px 10px;display:inline-block}}
    @media(max-width:620px){.search{flex-direction:column}.brand h1{font-size:24px}.map-help h2{font-size:28px}.tool-grid{grid-template-columns:1fr}.bottombar{grid-template-columns:1fr}.status{font-size:10px}}
  </style>
</head>
<body>
  <div id="map" aria-label="Interactive map of Ireland public context layers"></div>
  <main class="app">
    <header class="topbar">
      <section class="brand"><h1>Ireland<br/>Context Map</h1><p>Public evidence explorer</p></section>
      <section class="status"><span>Status: <b class="live">live map</b></span><span>Sources: <b>{manifest.publisherCount}</b></span><span>Updated: <b>{updatedLabel}</b></span><span>Use: <b>context only</b></span></section>
      <section class="search"><input id="q" value="Tallaght flooding" aria-label="Search for a place, issue or public data topic" /><button id="askBtn">Search</button></section>
    </header>

    <section class="workspace">
      <aside class="left">
        <section class="panel">
          <div class="panel-head"><span>Visible public layers</span><span class="count" id="layerCount">5 / 5</span></div>
          <div class="panel-body">
            {layers.map(group => <button class="layer-toggle" data-layer={group.id} aria-pressed="true"><div class="layer-group"><div class="layer-title"><span><i class="dot" style={`background:${group.color}`}></i>{group.group}</span><div class="switch" aria-hidden="true"></div></div><div class="layer-items">{group.items.join(' · ')}</div></div></button>)}
          </div>
        </section>
        <section class="panel">
          <div class="panel-head"><span>Places on map</span><span class="count" id="visibleCount">loading</span></div>
          <div class="panel-body" id="entityList"><p class="empty">Loading graph entities…</p></div>
        </section>
      </aside>

      <section class="center">
        <div class="map-help" id="mapHelp">
          <h2>Click the map to see relationships.</h2>
          <p>This is now a real MapLibre map. Layer toggles control visible civic data overlays. Selecting a place or entity draws relationship lines and opens plain-English public evidence.</p>
          <div class="chips">{examples.map(x => <button class="chip" data-question={x}>{x}</button>)}</div>
        </div>
        <div class="coords" id="coords">Move over map</div>
      </section>

      <aside class="right">
        <section class="panel">
          <div class="panel-head"><span>Explorer tools</span><span class="count">plain English</span></div>
          <div class="tool-grid">
            <button class="tool" data-tool="explain"><b>Explain area</b><span>Show possible context for the selected place.</span></button>
            <button class="tool" data-tool="evidence"><b>Show evidence</b><span>Open public source links and caveats.</span></button>
            <button class="tool" data-tool="nearby"><b>Find nearby</b><span>Fly to related places and services.</span></button>
            <button class="tool" data-tool="missing"><b>What's missing</b><span>Show where source adapters are still needed.</span></button>
          </div>
        </section>
        <section class="panel answer" id="answer"><div class="answer-inner"><p class="empty">Loading public context…</p></div></section>
      </aside>
    </section>

    <section class="bottombar" aria-label="Public graph summary">
      <div class="metric"><span>Datasets</span><b>{manifest.datasetCount?.toLocaleString?.() ?? manifest.datasetCount}</b></div>
      <div class="metric"><span>Publishers</span><b>{manifest.publisherCount?.toLocaleString?.() ?? manifest.publisherCount}</b></div>
      <div class="metric"><span>Real-world nodes</span><b>{manifest.realWorldNodeCount?.toLocaleString?.() ?? manifest.realWorldNodeCount}</b></div>
      <div class="metric"><span>Relationships</span><b>{manifest.realWorldRelationshipCount?.toLocaleString?.() ?? manifest.realWorldRelationshipCount}</b></div>
      <div class="metric"><span>Possible reasons</span><b>{manifest.brainFactorCount ?? 0}</b></div>
      <div class="metric"><span>Map layers</span><b>{manifest.housingPlanningLayerCount ?? 0}</b></div>
      <div class="metric"><span>Signals/tools</span><b>{(manifest.globalSignalSourceCount ?? 0) + (manifest.causalToolingCount ?? 0)}</b></div>
      <a class="metric" href="/mcp"><span>Developer</span><b>API / MCP</b></a>
    </section>
  </main>
  <details class="dev"><summary>Developer access</summary><a href="/mcp">MCP/API instructions</a></details>

  <script type="module" is:inline>
    // @ts-nocheck
    const LAYER_DEFS = {
      flood:{ label:'Water & flooding', domains:['weather','environment','infrastructure'], color:'#087f72', coords:[-6.37,53.30] },
      roads:{ label:'Roads & safety', domains:['roads','transport','collisions'], color:'#266fb4', coords:[-6.25,53.34] },
      services:{ label:'Public services', domains:['education','health','public-services','demographics'], color:'#278b51', coords:[-8.47,53.27] },
      planning:{ label:'Planning & change', domains:['planning','housing','local-government','energy'], color:'#b46f06', coords:[-6.26,53.35] },
      signals:{ label:'Global signals & causality', domains:['economy','environment','health','transport'], color:'#7c3aed', coords:[-7.2,52.7] }
    };
    const PLACE_COORDS = {
      'ireland':[-7.9,53.35], 'dublin':[-6.2603,53.3498], 'tallaght':[-6.3774,53.2867], 'south dublin':[-6.3774,53.2867], 'fingal':[-6.22,53.52], 'cork':[-8.4756,51.8985], 'galway':[-9.0568,53.2707], 'limerick':[-8.6267,52.6638], 'waterford':[-7.1119,52.2593], 'sligo':[-8.4761,54.2766], 'kerry':[-9.75,52.16], 'mayo':[-9.3,53.85], 'local authority areas':[-7.35,53.15], 'national roads and counters':[-7.15,53.38]
    };
    const TYPE_OFFSET = { issue:[0,0], factor:[.08,.04], asset:[-.08,.05], condition:[.05,-.08], event:[-.05,-.08], service:[.1,.1], agency:[-.1,.1], place:[0,0] };
    const state = { map:null, graph:null, brain:null, active:{flood:true,roads:true,services:true,planning:true,signals:true}, selected:null, popup:null, features:[], nodeById:new Map(), relsByNode:new Map() };
    const q = document.getElementById('q');
    const answer = document.getElementById('answer');
    const entityList = document.getElementById('entityList');
    const visibleCount = document.getElementById('visibleCount');
    const layerCount = document.getElementById('layerCount');
    const coords = document.getElementById('coords');
    const esc = s => String(s ?? '').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    const norm = s => String(s ?? '').toLowerCase();
    const hash = s => [...String(s)].reduce((n,ch)=>((n*31)+ch.charCodeAt(0))>>>0,7);
    const fmtPredicate = p => ({can_be_joined_spatially_with:'can be checked on a map with', covers_place:'covers this place', published_by:'is published by', describes:'describes', located_in:'is located in', observed_in:'is observed in', has_possible_factor:'has possible reason', supports_factor:'supports possible reason', has_time_context_from:'has time context from'}[p] || String(p||'is related to').replaceAll('_',' '));
    function domainLayer(domains=[]){ return Object.entries(LAYER_DEFS).find(([,d]) => domains.some(x => d.domains.includes(x)))?.[0] || 'services'; }
    function coordFor(node, index){
      const label = norm(node.label); const id = norm(node.id).replace(/^[^:]+:/,'').replaceAll('-',' ');
      for (const [k,v] of Object.entries(PLACE_COORDS)) if (label.includes(k) || id.includes(k)) return v;
      const layer = LAYER_DEFS[domainLayer(node.domains||[])]; const o = TYPE_OFFSET[node.type] || [0,0]; const h = hash(node.id);
      return [layer.coords[0] + o[0] + (((h%17)-8)*0.035), layer.coords[1] + o[1] + ((((h/17)|0)%17-8)*0.025)];
    }
    function layerColor(id){ return LAYER_DEFS[id]?.color || '#087f72'; }
    function strengthText(s){ return s === 'strong' ? 'strong evidence' : s === 'medium' ? 'some evidence' : s === 'weak' ? 'limited evidence' : 'evidence unclear'; }
    function simpleFactorLabel(label){
      const map = {'Rainfall intensity and duration':'Heavy rain','River level and upstream/downstream cascade':'Rivers and streams rising','Soil saturation and infiltration capacity':'Ground already soaked','Elevation, slope and flow paths':'Low ground and slopes','Impervious surface and land cover':'Concrete, roads and hard surfaces','Drainage, culverts and road barriers':'Drains, culverts and road layout'};
      return map[label] || label;
    }
    function issueForQuery(){
      const issues = state.brain?.issues || [];
      const text = norm(q.value);
      const ranked = issues.map(issue => ({issue, score:norm(`${issue.id} ${issue.label} ${(issue.examples||[]).join(' ')} ${(issue.factors||[]).map(f=>`${f.label} ${f.description} ${(f.keywords||[]).join(' ')}`).join(' ')}`).split(/\s+/).reduce((n)=>n,0)}));
      return issues.find(i => text.includes('flood') && norm(i.id).includes('flood')) || issues.find(i => text.includes('road') && norm(i.id).includes('road')) || issues.find(i => text.includes('service') && norm(i.id).includes('service')) || issues.find(i => text.includes('planning') && norm(i.id).includes('planning')) || issues[0];
    }
    function inferredPlace(){
      const text = norm(q.value);
      return Object.keys(PLACE_COORDS).find(k => text.includes(k)) || 'Ireland';
    }
    function buildGraphIndexes(graph){
      const baseNodes = (graph.nodes||[]).map((n,i)=>({...n, coords:coordFor(n,i), layerId:domainLayer(n.domains||[])}));
      const virtualPlaces = Object.entries(PLACE_COORDS).filter(([k]) => !['ireland','local authority areas','national roads and counters'].includes(k)).map(([name,coords]) => ({
        id:`place:${name.replaceAll(' ','-')}`, type:'place', label:name.replace(/\b\w/g,c=>c.toUpperCase()),
        description:'Searchable place anchor for inspecting nearby public-data context on the map.', domains:['local-government','public-services','roads','environment'], coords, layerId:'flood', virtual:true
      }));
      state.nodeById = new Map([...virtualPlaces, ...baseNodes].map(n=>[n.id,n]));
      state.relsByNode = new Map();
      for (const r of (graph.relationships||[])) {
        for (const key of [r.subject,r.object]) {
          if (!state.relsByNode.has(key)) state.relsByNode.set(key,[]);
          state.relsByNode.get(key).push(r);
        }
      }
      state.features = [...state.nodeById.values()].map(n => ({type:'Feature', geometry:{type:'Point', coordinates:n.coords}, properties:{id:n.id,label:n.label,type:n.type,layerId:n.layerId,description:n.description||'', domains:(n.domains||[]).join(', ')}}));
    }
    function emptyFc(){ return {type:'FeatureCollection',features:[]}; }
    function visibleFeatures(){ return state.features.filter(f => state.active[f.properties.layerId]); }
    function updateMapData(){
      if (!state.map?.getSource('entities')) return;
      const features = visibleFeatures();
      state.map.getSource('entities').setData({type:'FeatureCollection',features});
      visibleCount.textContent = `${features.length} visible`;
      layerCount.textContent = `${Object.values(state.active).filter(Boolean).length} / ${Object.keys(state.active).length}`;
      renderList(features.slice(0,18));
      updateRelationshipLines();
    }
    function renderList(features){
      const rank = {place:0, service:1, asset:2, issue:3, factor:4, condition:5, event:6, agency:7};
      const sorted = [...features].sort((a,b)=>(rank[a.properties.type]??9)-(rank[b.properties.type]??9) || String(a.properties.label).localeCompare(String(b.properties.label)));
      entityList.innerHTML = sorted.map(f => `<button class="tool entity-btn" data-node="${esc(f.properties.id)}"><b>${esc(f.properties.type)}</b><span>${esc(f.properties.label)}</span></button>`).join('') || '<p class="empty">No visible entities. Turn on a layer.</p>';
      entityList.querySelectorAll('[data-node]').forEach(b => b.onclick = () => selectNode(b.dataset.node, true));
    }
    function connectedRels(nodeId){
      const direct = (state.relsByNode.get(nodeId)||[]).filter(r => state.nodeById.has(r.subject) && state.nodeById.has(r.object));
      const node = state.nodeById.get(nodeId);
      if (!node?.virtual) return direct.slice(0,18);
      const wanted = ['asset:roads','asset:schools','asset:water-rivers-drainage','condition:rainfall-weather','service:health-services','service:public-facilities','event:collision-events','issue:flood-context'];
      const synthetic = wanted.filter(id => state.nodeById.has(id)).map(id => ({id:`virtual:${nodeId}:${id}`, subject:nodeId, predicate:'can_be_joined_spatially_with', object:id, confidence:'place-context', evidence:'map selection', caveats:['local adapter required']}));
      return synthetic.concat(direct).slice(0,18);
    }
    function updateRelationshipLines(){
      if (!state.map?.getSource('relations')) return;
      const rels = state.selected ? connectedRels(state.selected.id).filter(r => state.active[state.nodeById.get(r.subject)?.layerId] || state.active[state.nodeById.get(r.object)?.layerId]) : [];
      state.map.getSource('relations').setData({type:'FeatureCollection',features:rels.map(r=>({type:'Feature',geometry:{type:'LineString',coordinates:[state.nodeById.get(r.subject).coords,state.nodeById.get(r.object).coords]},properties:{predicate:r.predicate,confidence:r.confidence||'derived'}}))});
    }
    function renderAnswer(node){
      const issue = issueForQuery(); const factors = issue?.factors || []; const rels = connectedRels(node.id); const place = inferredPlace();
      const shownRels = rels.slice(0,4).map(r => {
        const otherId = r.subject === node.id ? r.object : r.subject; const other = state.nodeById.get(otherId);
        return `<div class="rel-row"><i>↔</i><div><b>${esc(node.label)} ${esc(fmtPredicate(r.predicate))} ${esc(other?.label || otherId)}.</b><br/><span>Evidence: ${esc(r.confidence || 'derived')} · ${esc(r.evidence || 'public-data relationship')} · not an official conclusion</span></div></div>`;
      }).join('');
      answer.innerHTML = `<div class="answer-inner">
        <div class="kicker"><span>Selected: ${esc(node.type)} · Layer: ${esc(LAYER_DEFS[node.layerId]?.label || node.layerId)}</span></div>
        <h2>${esc(node.label)}</h2>
        <div class="summary">${esc(node.description || 'Public graph entity.')} The visible lines show public-data relationships that can be inspected, not causal findings.</div>
        <div class="pill-row">${(node.domains||[]).slice(0,6).map(d=>`<span class="pill">${esc(d)}</span>`).join(' ')}</div>
        <div class="relationship">${shownRels || '<p class="empty">No connected visible relationships found for this selection yet.</p>'}</div>
        <div class="reason-list">
          ${factors.slice(0,3).map(f => `<article class="reason"><span class="badge">${esc(strengthText(f.strongestEvidence))}</span><h3>${esc(simpleFactorLabel(f.label))}</h3><p>${esc(f.description || 'This may be relevant to the question.')}</p><details class="sources"><summary>Evidence to inspect</summary>${(f.evidenceDatasets||[]).slice(0,3).map(e => `<a class="source-link" href="${esc(e.sourceUrl)}" target="_blank" rel="noreferrer"><strong>${esc(e.title)}</strong><br/><span>${esc(e.publisher)} · ${esc(e.license || 'licence to verify')}</span></a>`).join('') || '<p class="empty">No strong public source linked yet.</p>'}</details></article>`).join('')}
        </div>
        <details class="sources"><summary>What is still unknown</summary><p class="empty">Some relationships are metadata-derived and marked as adapter-required. Exact street-level truth needs source-specific geospatial and temporal joins.</p></details>
      </div>`;
    }
    function selectNode(id, fly=false){
      const node = state.nodeById.get(id); if (!node) return; state.selected = node; renderAnswer(node); updateRelationshipLines();
      if (fly && state.map) state.map.flyTo({center:node.coords, zoom: node.type === 'place' ? 8 : 7.2, duration:800});
    }
    function selectForQuery(){
      const text = norm(q.value); let chosen = [...state.nodeById.values()].find(n => text.includes(norm(n.label)) || norm(n.label).includes(text));
      if (!chosen) {
        const place = inferredPlace(); chosen = [...state.nodeById.values()].find(n => norm(n.label).includes(place)) || [...state.nodeById.values()].find(n => n.type === 'place') || [...state.nodeById.values()][0];
      }
      selectNode(chosen.id, true);
    }
    function initMap(){
      if (!window.maplibregl) { answer.innerHTML = '<div class="answer-inner"><p class="empty">Map library failed to load.</p></div>'; return; }
      const map = new maplibregl.Map({ container:'map', style:'https://basemaps.cartocdn.com/gl/positron-gl-style/style.json', center:[-7.75,53.25], zoom:6.25, minZoom:5, maxZoom:15, attributionControl:false });
      state.map = map;
      map.addControl(new maplibregl.NavigationControl({visualizePitch:true}), 'bottom-left');
      map.on('mousemove', e => { coords.textContent = `${e.lngLat.lat.toFixed(4)}, ${e.lngLat.lng.toFixed(4)}`; });
      map.on('load', () => {
        map.addSource('relations', {type:'geojson', data:emptyFc()});
        map.addSource('entities', {type:'geojson', data:emptyFc(), cluster:true, clusterRadius:38, clusterMaxZoom:8});
        map.addLayer({id:'relations-line', type:'line', source:'relations', paint:{'line-color':'#087f72','line-width':['interpolate',['linear'],['zoom'],5,1.5,10,4],'line-opacity':.56,'line-dasharray':[2,2]}});
        map.addLayer({id:'clusters', type:'circle', source:'entities', filter:['has','point_count'], paint:{'circle-color':'#ffffff','circle-stroke-color':'#087f72','circle-stroke-width':2,'circle-radius':['step',['get','point_count'],16,10,21,30,27],'circle-opacity':.94}});
        map.addLayer({id:'cluster-count', type:'symbol', source:'entities', filter:['has','point_count'], layout:{'text-field':['get','point_count_abbreviated'],'text-size':12}, paint:{'text-color':'#102623'}});
        map.addLayer({id:'entity-glow', type:'circle', source:'entities', filter:['!', ['has','point_count']], paint:{'circle-radius':['interpolate',['linear'],['zoom'],5,9,10,18],'circle-color':['match',['get','layerId'],'flood','#087f72','roads','#266fb4','services','#278b51','planning','#b46f06','#087f72'],'circle-opacity':.13,'circle-blur':.9}});
        map.addLayer({id:'entity-points', type:'circle', source:'entities', filter:['!', ['has','point_count']], paint:{'circle-radius':['interpolate',['linear'],['zoom'],5,5,10,9],'circle-color':['match',['get','layerId'],'flood','#087f72','roads','#266fb4','services','#278b51','planning','#b46f06','#087f72'],'circle-stroke-width':2,'circle-stroke-color':'#fffffb','circle-opacity':.88}});
        map.addLayer({id:'entity-labels', type:'symbol', source:'entities', minzoom:7, filter:['!', ['has','point_count']], layout:{'text-field':['get','label'],'text-size':11,'text-offset':[0,1.3],'text-anchor':'top','text-max-width':12}, paint:{'text-color':'#102623','text-halo-color':'#fffffb','text-halo-width':1.4}});
        map.on('click','entity-points', e => { const f=e.features?.[0]; if (f) selectNode(f.properties.id); });
        map.on('click','clusters', async e => { const f=e.features?.[0]; const id=f?.properties?.cluster_id; const z=await map.getSource('entities').getClusterExpansionZoom(id); map.easeTo({center:f.geometry.coordinates,zoom:z}); });
        map.on('mouseenter','entity-points',()=>map.getCanvas().style.cursor='pointer'); map.on('mouseleave','entity-points',()=>map.getCanvas().style.cursor='');
        updateMapData(); selectForQuery();
      });
    }
    async function loadData(){
      const [graph, brain] = await Promise.all([fetch('/data/real-world-graph.json').then(r=>r.json()), fetch('/data/brain-index.json').then(r=>r.json())]);
      state.graph = graph; state.brain = brain; buildGraphIndexes(graph); if (state.map?.loaded()) { updateMapData(); selectForQuery(); }
    }
    document.querySelectorAll('[data-layer]').forEach(btn => btn.onclick = () => { const id=btn.dataset.layer; state.active[id]=!state.active[id]; btn.setAttribute('aria-pressed', String(state.active[id])); btn.querySelector('.layer-group')?.classList.toggle('off', !state.active[id]); updateMapData(); });
    document.querySelectorAll('[data-question]').forEach(b => b.onclick = () => { q.value = b.dataset.question; selectForQuery(); });
    document.getElementById('askBtn').onclick = () => selectForQuery(); q.addEventListener('keydown', e => { if(e.key === 'Enter') selectForQuery(); });
    document.querySelectorAll('[data-tool]').forEach(b => b.onclick = () => { if (state.selected) { renderAnswer(state.selected); if (b.dataset.tool === 'evidence') answer.querySelector('details.sources')?.setAttribute('open',''); } });
    initMap(); loadData().catch(err => { console.error(err); answer.innerHTML = '<div class="answer-inner"><p class="empty">Public context data failed to load.</p></div>'; });
  </script>
</body>
</html>
